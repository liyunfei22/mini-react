{
  "name": "@mini-react/shared",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "description": "内部共享工具与跨包总线（ReactSharedInternals）—— 对应官方 packages/shared，不属于公开产物，构建时被内联进各消费包",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": {
        "import": "./src/index.ts",
        "require": "./src/index.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts"
}